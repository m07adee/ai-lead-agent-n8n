{
  "name": "AI Lead Agent — Multilingual Form + Email Alerts (Claude)",
  "nodes": [
    {
      "id": "lead-webhook",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -480,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "4f6b2c1e-8a3d-4e5f-9b7c-0d1e2f3a4b5c"
    },
    {
      "id": "validate-and-normalize",
      "name": "Validate & Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -260,
        300
      ],
      "parameters": {
        "jsCode": "// Clean + validate the public form submission\nconst b = $json.body || {};\nconst s = (v, n) => String(v ?? '').trim().slice(0, n);\nconst lang = ['en', 'ar', 'tr'].includes(b.lang) ? b.lang : 'en';\nconst lead = {\n  name: s(b.name, 80),\n  email: s(b.email, 120).toLowerCase(),\n  phone: s(b.phone, 25),\n  company: s(b.company, 100),\n  project_type: s(b.type, 40) || 'Not specified',\n  budget: s(b.budget, 40),\n  message: s(b.message, 3000),\n  lang,\n  language: { en: 'English', ar: 'Arabic', tr: 'Turkish' }[lang],\n  submitted_at: new Date().toISOString(),\n};\nconst valid = !s(b.website, 200)                       // honeypot must be empty\n  && lead.name.length > 1\n  && /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(lead.email)\n  && /^\\+?[\\d\\s\\-()]{7,20}$/.test(lead.phone)\n  && lead.message.length > 3;\nreturn [{ json: { ...lead, valid } }];"
      }
    },
    {
      "id": "valid-lead",
      "name": "Valid Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -40,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "respond-invalid",
      "name": "Respond: Invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
