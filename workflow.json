    {
      "id": "email-me-new-lead",
      "name": "Email Me: New Lead",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1520,
        300
      ],
      "parameters": {
        "fromEmail": "Lead Agent <you@example.com>",
        "toEmail": "you@example.com",
        "subject": "={{ $json.tier === 'Spam' ? '⚠️ Possible spam' : $json.tier === 'Hot' ? '🔥 HOT lead' : $json.tier + ' lead' }} ({{ $json.lead_score }}/100): {{ $json.name }} — {{ $json.intent }}",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,sans-serif;max-width:640px;margin:auto\"><div style=\"background:{{ $json.tier === 'Hot' ? '#dc2626' : $json.tier === 'Warm' ? '#f59e0b' : '#6b7280' }};color:#fff;padding:18px 20px;border-radius:10px 10px 0 0\"><div style=\"font-size:13px;opacity:.9\">New lead · {{ $json.submitted_at }}</div><div style=\"font-size:22px;font-weight:bold\">{{ $json.tier === 'Spam' ? '⚠️ Possible spam' : $json.tier === 'Hot' ? '🔥 HOT lead' : $json.tier + ' lead' }} — {{ $json.lead_score }}/100</div><div style=\"font-size:13px;margin-top:4px\">{{ $json.next_action }}</div></div><table style=\"width:100%;border:1px solid #e5e7eb;border-top:0;border-collapse:collapse;font-size:14px\"><tr><td style=\"padding:8px 12px;color:#6b7280;width:130px;vertical-align:top\">Name</td><td style=\"padding:8px 12px;color:#111827\">{{ $json.h.name }}</td></tr><tr><td style=\"padding:8px 12px;color:#6b7280;width:130px;vertical-align:top\">Email</td><td style=\"padding:8px 12px;color:#111827\"><a href=\"mailto:{{ $json.h.email }}\">{{ $json.h.email }}</a></td></tr><tr><td style=\"padding:8px 12px;color:#6b7280;width:130px;vertical-align:top\">Phone</td><td style=\"padding:8px 12px;color:#111827\">{{ $json.h.phone }} · <a href=\"https://wa.me/{{ $json.whatsapp }}\">WhatsApp</a></td></tr><tr><td style=\"padding:8px 12px;color:#6b7280;width:130px;vertical-align:top\">Company</td><td style=\"padding:8px 12px;color:#111827\">{{ $json.h.company }}</td></tr><tr><td style=\"padding:8px 12px;color:#6b7280;width:130px;vertical-align:top\">Project type</td><td style=\"padding:8px 12px;color:#111827\">{{ $json.h.ptype }}</td></tr><tr><td style=\"padding:8px 12px;color:#6b7280;width:130px;vertical-align:top\">Budget</td><td style=\"padding:8px 12px;color:#111827\">{{ $json.h.budget }}</td></tr><tr><td style=\"padding:8px 12px;color:#6b7280;width:130px;vertical-align:top\">Language</td><td style=\"padding:8px 12px;color:#111827\">{{ $json.language }}</td></tr><tr><td style=\"padding:8px 12px;color:#6b7280;width:130px;vertical-align:top\">Intent</td><td style=\"padding:8px 12px;color:#111827\">{{ $json.intent }} · urgency: {{ $json.urgency }}</td></tr><tr><td style=\"padding:8px 12px;color:#6b7280;width:130px;vertical-align:top\">Summary</td><td style=\"padding:8px 12px;color:#111827\">{{ $json.h.summary }}</td></tr><tr><td style=\"padding:8px 12px;color:#6b7280;width:130px;vertical-align:top\">Requirements</td><td style=\"padding:8px 12px;color:#111827\"><ul style=\"margin:0;padding-left:18px\">{{ $json.h.reqs }}</ul></td></tr><tr><td style=\"padding:8px 12px;color:#6b7280;width:130px;vertical-align:top\">Message</td><td style=\"padding:8px 12px;color:#111827\">{{ $json.h.message }}</td></tr></table><h3 style=\"margin:22px 0 8px\">{{ $json.tier === 'Spam' ? 'No email sent to this sender (flagged as spam — check it yourself)' : 'AI reply already sent to the client' }}</h3><div style=\"background:#f3f4f6;border-radius:10px;padding:14px 16px;font-size:14px;line-height:1.6\">{{ $json.h.reply || '—' }}</div><p style=\"margin-top:20px\"><a href=\"mailto:{{ $json.h.email }}\" style=\"background:#7c5cff;color:#fff;padding:10px 16px;border-radius:8px;text-decoration:none\">Reply by email</a> &nbsp;<a href=\"https://wa.me/{{ $json.whatsapp }}\" style=\"background:#16a34a;color:#fff;padding:10px 16px;border-radius:8px;text-decoration:none\">Message on WhatsApp</a></p></div>",
        "options": {
          "appendAttribution": false,
          "replyTo": "={{ $json.email }}"
        }
      },
      "credentials": {
        "smtp": {
          "id": "gmailSmtpLead01A",
          "name": "Gmail SMTP (lead alerts)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "email-client-ai-reply",
      "name": "Email Client: AI Reply",
      "type": "n8n-nodes-base.emailSend",
