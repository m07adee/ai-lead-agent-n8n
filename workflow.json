        "subject": "={{ {en: 'Re: your project request — Mohammad Adeeb', ar: 'بخصوص طلب مشروعك — محمد أديب', tr: 'Proje talebiniz hakkında — Mohammad Adeeb'}[$('Respond to Visitor').item.json.lang] }}",
        "emailFormat": "text",
        "text": "={{ $('Respond to Visitor').item.json.ai_reply }}",
        "options": {
