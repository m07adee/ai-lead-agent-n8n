    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"intent\": { \"type\": \"string\" },\n    \"urgency\": { \"type\": \"string\", \"enum\": [\"low\", \"medium\", \"high\"] },\n    \"fit_score\": { \"type\": \"integer\" },\n    \"summary\": { \"type\": \"string\" },\n    \"key_requirements\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n    \"reply\": { \"type\": \"string\" }\n  },\n  \"required\": [\"intent\", \"urgency\", \"fit_score\", \"summary\", \"key_requirements\", \"reply\"]\n}"
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Structured Output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        320,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "// Combine lead data + AI analysis into a final score and tier\nconst lead = $('Validate & Normalize').first().json;\nconst ai = $input.first().json.output;\n\nconst budgetPoints = { 'Under $500': 5, '$500 - $2,000': 15, '$2,000 - $10,000': 25, '$10,000+': 30, 'Not sure yet': 10 };\nconst urgencyPoints = { low: 0, medium: 5, high: 10 };\n\nlet score = Math.round((ai.fit_score || 0) * 0.6) + (budgetPoints[lead.budget] || 0) + (urgencyPoints[ai.urgency] || 0);\nif (ai.intent === 'Spam') score = 0;\nscore = Math.max(0, Math.min(100, score));\nconst tier = ai.intent === 'Spam' ? 'Spam' : score >= 70 ? 'Hot' : score >= 40 ? 'Warm' : 'Cold';\n\nconst esc = v => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst reqs = ai.key_requirements || [];\nreturn [{\n  json: {\n    ...lead,\n    first_name: lead.name.split(' ')[0] || 'there',\n    intent: ai.intent,\n    urgency: ai.urgency,\n    lead_score: score,\n    tier,\n    summary: ai.summary,\n    key_requirements: reqs.join('; '),\n    ai_reply: ai.reply,\n    whatsapp: lead.phone.replace(/\\D/g, ''),\n    h: {  // HTML-escaped copies for the notification email\n      name: esc(lead.name), email: esc(lead.email), phone: esc(lead.phone), company: esc(lead.company || '—'),\n      budget: esc(lead.budget), ptype: esc(lead.project_type), message: esc(lead.message).replace(/\\n/g, '<br>'), summary: esc(ai.summary),\n      reqs: reqs.map(r => '<li>' + esc(r) + '</li>').join(''), reply: esc(ai.reply).replace(/\\n/g, '<br>'),\n    },\n  },\n}];"
      },
